# ---- Public (shipped to the browser; safe by design) ----
NEXT_PUBLIC_APP_NAME=IdeaBridge
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional override; default claude-opus-5-5
ANTHROPIC_MODEL=
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=change-me-to-a-long-random-string
RESEND_API_KEY=
EMAIL_FROM="IdeaBridge <no-reply@yourdomain.pk>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Your own malware scanner endpoint (e.g. ClamAV REST). Unset = files marked "unscanned"
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
